# Copy to .env and fill in. Nothing here is required to run repository
# analysis, the RAG pipeline, or the test suites -- only the LLM-dependent
# agent steps (understanding, planning, generation, repair) need a key.

# Pick ONE provider. If both are set, PAYSHIFT_LLM_PROVIDER decides; if
# neither is set, the agent runs and genuinely reports itself as blocked
# at the first reasoning step rather than fabricating output.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force a provider when both keys are set ("openai" | "anthropic").
PAYSHIFT_LLM_PROVIDER=

# Optional: override the default model for the chosen provider.
PAYSHIFT_LLM_MODEL=

# Optional: a sample-app Stripe test key, for exercising the REAL
# StripeApiPaymentGateway code path outside of the mocked test suite.
# Never put a live/production key here.
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
